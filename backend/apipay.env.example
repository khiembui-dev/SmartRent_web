# Tên biến cho tiến trình SERVER; đây là tài liệu mẫu, .NET không tự nạp file này.
# Dùng backend/start-apipay.ps1 để nhập secret kín trong terminal, hoặc secret manager trên server.
# Không sao chép khóa thật vào root .env (file đó đang được Git theo dõi trong dự án này).
APIPAY_ENABLED=false
APIPAY_ACCESS_KEY=
APIPAY_SECRET_KEY=
APIPAY_WEBHOOK_SECRET=
APIPAY_WEBHOOK_URL=https://your-api-domain.example/api/v1/apipay/webhook
APIPAY_BANK_PUBLIC_ID=cmwf0n7b20xp301tjzi8z6dpc
# IP proxy trực tiếp kết nối Kestrel; để trống nếu Kestrel tự phục vụ HTTPS.
APIPAY_TRUSTED_PROXIES=
# Chỉ dùng cho tunnel local trỏ vào listener riêng; cổng này chặn mọi route trừ POST webhook.
APIPAY_WEBHOOK_LISTENER_PORT=
