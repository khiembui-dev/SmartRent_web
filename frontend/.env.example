# Cấu hình công khai của frontend. Mọi biến VITE_* sẽ nằm trong bundle trình duyệt:
# KHÔNG đặt mật khẩu, connection string, API key hay secret ở đây.

# mock = chạy hoàn toàn bằng dữ liệu mô phỏng trong trình duyệt (mặc định).
# api  = gọi backend thật tại VITE_API_BASE_URL. Chỉ dùng khi backend ASP.NET Core đã triển khai
#        đúng hợp đồng docs/api/openapi.yaml. Lỗi API sẽ hiển thị, không tự chuyển về mock.
VITE_DATA_SOURCE=mock

# Gốc API (không có dấu / ở cuối). Đường dẫn endpoint đã gồm /api/v1/...
# Ví dụ: https://api.smartrent.example  hoặc để trống khi frontend và API cùng origin/proxy.
VITE_API_BASE_URL=

# Thời gian chờ tối đa cho mỗi request (ms).
VITE_API_TIMEOUT_MS=15000

# Độ trễ mô phỏng của mock (ms), dạng "min,max". Dùng để thấy trạng thái đang tải.
VITE_MOCK_LATENCY=150,450

# Base path khi deploy dưới thư mục con, ví dụ /smartrent/. Mặc định /.
VITE_BASE_PATH=/

# Chỉ dùng cho `npm run dev`: proxy /api tới backend local để tránh CORS khi phát triển.
# Ví dụ: http://localhost:5080
VITE_DEV_API_PROXY=
